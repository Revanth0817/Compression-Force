            </div>

            <div class="col-sm-0 order-md-3 order-lg-2 col-md-0 col-lg-2"></div>

            <div class="col-sm-12 order-md-2 order-lg-3 col-md-6 col-lg-5">
                <div class="d-flex justify-content-lg-end flex-column">
                    <div class="d-flex gap-3 align-items-center justify-content-between pb-2">
                        <label class="font-size-16 min-width-30 fw-semibold clr-242424">Table Thickness</label>
                        <div class="d-flex align-items-center gap-10px max-width-115px">
                            <input type="text" id="tabletThickness"

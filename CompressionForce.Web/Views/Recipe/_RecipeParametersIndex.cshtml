@using System.Collections.Generic
@using System.Linq
@using CompressionForce.Domain.Validation
@using CompressionForce.Domain.Entities;
@model CompressionForce.Services.DTOs.RecipeDto

@{
    //var parameters = Model.Parameters as IEnumerable<RecipeParameter>;

    var parameters = Model?.Parameters as List<RecipeParameter> ?? new();

    var parametersDict = parameters?.ToDictionary(p => p.Name, p => p)
        ?? new Dictionary<string, RecipeParameter>();
}


                <!--Common Product Parameter-->
<div class="commonProductParameter boxshadow bord-rad-4px mt-0">
    <div class="commonProductHeader fw-semibold bgcol-215ED6 text-white text-center font-size-18px p-10px">
        Common Product Parameter
    </div>
    <div class="py-4">
        <div class="px-lg-4 px-md-4 px-sm-3 px-3">
            <div class="commonProductHeaderSelectors d-flex flex-wrap gap-3 justify-content-between pb-4">

                <div class="d-flex gap-3 align-items-center">
                    <label class="font-size-16px fw-semibold clr-242424">Tool Type</label>
                    <div class="d-flex toolTypeDropdown batchDropdown position-relative">
                        <input type="text" id="toolTypeInput" class="form-control flex-grow-1 dropdownInput bord-D2D2D2"
                               value=@parametersDict["ToolType"].Value readonly>
                        <button type="button" class="bgcol-215ED6 border-0 flex-shrink-0 text-white dropdown-toggle dropdown-toggle-split dropdown-btn" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul id="toolTypeDropdown" class="dropdown-menu dropdown-menu-end">

                        </ul>
                    </div>
                </div>

                <div class="d-flex gap-3 align-items-center">
                    <label class="font-size-16px fw-semibold clr-242424">AWC & AR</label>
                    <div class="d-flex commonProductDropdown batchDropdown position-relative">
                        <input type="text" id="awcInput" class="form-control flex-grow-1 dropdownInput bord-D2D2D2"
                               value=@parametersDict["AWC&AR"].Value readonly>
                        <button type="button" class="bgcol-215ED6 border-0 flex-shrink-0 text-white dropdown-toggle dropdown-toggle-split dropdown-btn" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul id="awcListDropdown" class="dropdown-menu dropdown-menu-end">

                        </ul>
                    </div>
                </div>

                <div class="d-flex gap-3 align-items-center">
                    <label class="font-size-16px fw-semibold clr-242424">Recipe</label>
                    <div class="d-flex commonProductDropdown batchDropdown position-relative">
                        <input type="text" id="recipeInput" class="form-control flex-grow-1 dropdownInput bord-D2D2D2"
                               value=@parametersDict["Recipe"].Value readonly>
                        <button type="button" class="bgcol-215ED6 border-0 flex-shrink-0 text-white dropdown-toggle dropdown-toggle-split dropdown-btn" data-bs-toggle="dropdown" aria-expanded="false">
                            <span class="visually-hidden">Toggle Dropdown</span>
                        </button>
                        <ul id="recipeListDropdown" class="dropdown-menu dropdown-menu-end">

                        </ul>
                    </div>
                </div>

            </div>
        </div>                        <div class="row px-lg-4 px-md-4 px-sm-3 px-3 commonProductContainer">

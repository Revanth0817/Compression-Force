                                   placeholder="0.00" value=@parametersDict["TabletThickness"].Value readonly />
                            <span class="font-size-16px fw-semibold clr-242424">mm</span>
                        </div>
                    </div>
                    <div class="d-flex gap-3 align-items-center justify-content-between pb-2">
                        <label class="font-size-16px min-width-30 fw-semibold clr-242424">Table Hardness</label>
                        <div class="d-flex align-items-center gap-10px max-width-115px">
                            <input type="text" id="tabletHardness"
                                   class="bord-D2D2D2 px-12-py-6px w-70px bord-rad-4px font-size-12px col-242424 fw-semibold text-center"
                                   placeholder="0.00" value=@parametersDict["TabletHardness"].Value readonly />
                            <span class="font-size-16px fw-semibold clr-242424">kpa</span>
                        </div>
                    </div>
                    <div class="d-flex gap-3 align-items-center justify-content-between pb-2">
                        <label class="font-size-16px min-width-30 fw-semibold clr-242424">Table Weight</label>
                        <div class="d-flex align-items-center gap-10px max-width-115px">
                            <input type="text" id="tabletWeight"
                                   class="bord-D2D2D2 px-12-py-6px w-70px bord-rad-4px font-size-12px col-242424 fw-semibold text-center"
                                   placeholder="0.00" value=@parametersDict["TabletWeight"].Value readonly />
                            <span class="font-size-16px fw-semibold clr-242424">mg</span>
                        </div>
                    </div>
                    <div class="d-flex gap-3 align-items-center justify-content-between pb-2">
                        <label class="font-size-16px min-width-30 fw-semibold clr-242424">Max Turret RPM</label>
                        <div class="d-flex align-items-center gap-10px max-width-115px">
                            <input type="text" id="maxTurretRpm"
                                   class="bord-D2D2D2 px-12-py-6px w-70px bord-rad-4px font-size-12px col-242424 fw-semibold text-center"
                                   placeholder="0.00" value=@parametersDict["MaxTurretRpm"].Value readonly />
                            <span class="font-size-16px fw-semibold clr-242424">rpm</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


                    <tr class="text-center fw-normal col-242424 font-size-13px">
                        <td>09/01/2024 22:06:26</td>
                        <td>ADMIN</td>
                        <td>Privilege Changed for Administrator</td>
                        <td>User Management</td>
                    </tr>
                    <!-- Add more rows dynamically -->
                </tbody>
            </table>

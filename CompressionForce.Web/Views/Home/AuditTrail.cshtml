<div class="container-fluid p-4 d-flex flex-column min-vh-75">
    <div class="flex-grow-1">
        <!-- Header + Buttons -->
        <div class="row align-items-center mb-4 mb-md-4">
            <div class="col-md-4 col-12">
                <h5 class="font-size-20px col-215ED6 fw-semibold mb-3 mb-md-0">Audit Trial</h5>
            </div>
            <div class="col-md-8 col-12 d-flex flex-wrap justify-content-md-end gap-3">
                <div class="d-flex gap-3">
                    <button type="button" class="btn btn-primary btn-sm">
                        Fetch Report
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm">
                        Print Report
                    </button>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <label class="fw-semibold col-242424 font-size-14px mb-0">Total No. Of Alarms</label>
                    <input type="text"
                           class="form-control form-control-sm shadow-custom bg-white max-w-63px fw-semibold col-242424 font-size-14px"
                           value="139"
                           readonly>
                </div>
            </div>
        </div>

        <!-- Filters Row -->
        <div class="row gy-3 mb-4 mb-md-4">
            <!-- From Date Time -->
            <div class="col-md-6 col-12 d-flex align-items-center gap-2">
                <label class="fw-semibold font-size-14px col-242424 mb-0 text-nowrap min-w-120px">
                    From Date Time
                </label>
                <div class="input-group w-100">
                    <input type="text" class="form-control form-control-sm fw-normal col-242424 font-size-13px" value="11/22/2024 10:07:48">
                    <span class="input-group-text calendar-btn bgcol-215ED6 d-flex align-items-center justify-content-center p-0 w-26px h-32px">
                        <img src="~/images/bx_calendar.png" alt="calendar-icon" class="w-16px h-16px">
                    </span>
                </div>
            </div>

            <!-- To Date Time -->
            <div class="col-md-6 col-12 d-flex align-items-center gap-2">
                <label class="fw-semibold font-size-14px col-242424 mb-0 text-nowrap min-w-120px">
                    To Date Time
                </label>
                <div class="input-group w-100">
                    <input type="text" class="form-control form-control-sm fw-normal col-242424 font-size-13px" value="11/22/2024 10:07:48">
                    <span class="input-group-text calendar-btn bgcol-215ED6 d-flex align-items-center justify-content-center p-0 w-26px h-32px">
                        <img src="~/images/bx_calendar.png" alt="calendar-icon" class="w-16px h-16px">
                    </span>
                </div>
            </div>

            <!-- User Name -->
            <div class="col-md-6 col-12 d-flex align-items-center gap-2">
                <label class="fw-semibold font-size-14px col-242424 mb-0 text-nowrap min-w-120px">User Name</label>
                <div class="input-group input-group-sm bord-D2D2D2 bord-rad-4px overflow-hidden w-100 p-0">
                    <input type="text" id="UserName" class="form-control bg-white border-0 fw-normal col-242424 font-size-13px" value="None" readonly />
                    <button class="btn bgcol-215ED6 text-white border-0 dropdown-toggle font-size-14px" type="button" data-bs-toggle="dropdown" aria-expanded="false"></button>
                    <ul class="dropdown-menu dropdown-menu-end font-size-14px">
                        <li><a class="dropdown-item" href="#">Admin</a></li>
                        <li><a class="dropdown-item" href="#">Operator</a></li>
                    </ul>
                </div>
            </div>

            <!-- Activity -->
            <div class="col-md-6 col-12 d-flex align-items-center gap-2">
                <label class="fw-semibold font-size-14px col-242424 mb-0 text-nowrap min-w-120px">Activity</label>
                <div class="input-group input-group-sm bord-D2D2D2 bord-rad-4px overflow-hidden w-100 p-0">
                    <input type="text" id="Activity" class="form-control bg-white border-0 fw-normal col-242424 font-size-13px" value="None" readonly />
                    <button class="btn bgcol-215ED6 text-white border-0 dropdown-toggle font-size-14px" type="button" data-bs-toggle="dropdown" aria-expanded="false"></button>
                    <ul class="dropdown-menu dropdown-menu-end font-size-14px">
                        <li><a class="dropdown-item" href="#">Login</a></li>
                        <li><a class="dropdown-item" href="#">Logout</a></li>
                        <li><a class="dropdown-item" href="#">User Management</a></li>
                    </ul>

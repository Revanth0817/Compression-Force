                                                   value="@Model.SelectedRecipe?.MaxTurretRpm" placeholder="0.00" readonly />
                                            <span class="font-size-16px fw-semibold clr-242424">rpm</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


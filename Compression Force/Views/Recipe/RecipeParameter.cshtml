<!-- Add Recipe -->

<div class="modal fade" id="addRecipeModal" tabindex="-1" aria-labelledby="addRecipeLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bord-rad-8px shadow">

            <div class="modal-header bgcol-215ED6 text-white px-3 py-2">
                <h5 class="modal-title fw-semibold font-size-18px" id="addRecipeLabel">Add Recipe</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body border-bottom-0">
                <label for="recipeName" class="fw-semibold col-242424 font-size-14px mb-1">Enter the Recipe Name</label>
                <input type="text" id="recipeName" class="form-control font-size-14px col-242424 fw-normal" placeholder="e.g. R-1001">

                <div id="duplicateError" class="text-danger font-size-12px mt-2 fw-semibold" style="display:none;">
                    ⚠ This Recipe Code already exists in the database.
                </div>
            </div>

            <div class="modal-footer justify-content-end border-top-0 p-3 pt-0">
                <button type="button" class="btn col-215ED6 bord-215ED6 fw-semibold font-size-16px px-4" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnConfirmAdd" class="btn bgcol-215ED6 text-white fw-semibold font-size-16px px-4">Save</button>
            </div>
        </div>
    </div>
</div>

<script>
    function updateRecipeSelection(code) {
        // Updates the main display box
        document.getElementById('currentRecipeCode').value = code;

        // Optional: If you want to automatically fill the "Recipe Code"
        // box inside the "Common Product Parameter" section:
        const recipeInput = document.querySelector('input[placeholder="4444"]');
        if(recipeInput) recipeInput.value = code;

        console.log("Selected Recipe: " + code);
    }

    // Auto-show modal if there's an error from the Controller
    document.addEventListener("DOMContentLoaded", function () {
        var error = '@TempData["ErrorMessage"]';
        if (error && error.length > 0) {
            var myModal = new bootstrap.Modal(document.getElementById('addRecipeModal'));
            myModal.show();
        }
    });
</script>

<script>
    document.getElementById('btnConfirmAdd').addEventListener('click', function () {
        const codeValue = document.getElementById('recipeName').value.trim();
        const errorDiv = document.getElementById('duplicateError');
        const inputField = document.getElementById('recipeName');

        if (!codeValue) {
            alert("Please enter a Recipe Name/Code.");
            return;
        }

        // AJAX call to check database
        fetch(`/Recipe/CheckCodeExists?code=${encodeURIComponent(codeValue)}`)
            .then(response => response.json())
            .then(data => {
                if (data.exists) {
                    // CASE 1: Code exists - STAY in modal and show error
                    errorDiv.style.display = 'block';
                    inputField.classList.add('is-invalid');
                } else {
                    // CASE 2: Code is unique - PROCEED to the AddRecipe page
                    errorDiv.style.display = 'none';
                    inputField.classList.remove('is-invalid');
                    window.location.href = `/Recipe/AddRecipe?code=${encodeURIComponent(codeValue)}`;
                }
            })
            .catch(err => {
                console.error('Error:', err);
                alert("An error occurred while checking the recipe code.");
            });
    });

    // Reset error styling when user types again
    document.getElementById('recipeName').addEventListener('input', function() {
        document.getElementById('duplicateError').style.display = 'none';
        this.classList.remove('is-invalid');
    });
</script>
<script>
    // This single listener handles the common behavior for all three sections
    document.addEventListener('click', function (e) {
        if (e.target.classList.contains('readonly-item')) {
            e.preventDefault();
            e.stopPropagation();

            // Just close the dropdown menu without updating any values
            const btn = e.target.closest('.batchDropdown').querySelector('.dropdown-btn');
            bootstrap.Dropdown.getOrCreateInstance(btn).hide();
        }
    });
</script>

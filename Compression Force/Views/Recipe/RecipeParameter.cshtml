                                        <button type="button" class="bgcol-215ED6 border-0 flex-shrink-0 text-white dropdown-toggle dropdown-toggle-split dropdown-btn" data-bs-toggle="dropdown" aria-expanded="false">
                                            <span class="visually-hidden">Toggle Dropdown</span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            @foreach (var item in toolTypes)
                                            {
                                                <li><a class="dropdown-item readonly-item" href="javascript:void(0)">@item</a></li>
                                            }
                                        </ul>
                                    </div>
                                </div>

                                <div class="d-flex gap-3 align-items-center">
                                    <label class="font-size-16px fw-semibold clr-242424">AWC & AR</label>
                                    <div class="d-flex commonProductDropdown batchDropdown position-relative">
                                        <input type="text" class="form-control flex-grow-1 dropdownInput bord-D2D2D2"

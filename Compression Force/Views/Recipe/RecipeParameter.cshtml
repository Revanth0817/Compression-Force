                                            <option value="0.5" selected="@(Model.SelectedRecipe?.ForceFeederRatioS1 == 0.5f ? "selected" : null)">0.5</option>
                                            <option value="2.0" selected="@(Model.SelectedRecipe?.ForceFeederRatioS1 == 2.0f ? "selected" : null)">2.0</option>
                                        </select>
                                        <span class="font-size-16px fw-semibold clr-242424 vis-hidden">mm</span>

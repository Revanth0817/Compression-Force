@model Compression_Force.Models.RecipeParameterViewModel
@using System.Collections
@using System.Linq

@{
    // Define a local function. This is more stable in Razor than a Func variable.
    IEnumerable GetItems(object val)
    {
        if (val == null) return new List<string> { "" };
        if (val is string s) return new List<string> { s };
        if (val is IEnumerable enumerable) return enumerable;
        return new List<string> { val.ToString() };
    }

    // Pre-calculate the data to avoid calling methods inside the HTML attributes
    var toolTypes = GetItems(Model.SelectedRecipe?.ToolType);
    var awcList = GetItems(new[] { "Item1", "1111" });
    var recipeList = GetItems(Model.SelectedRecipe?.RecipeName);

    // Get display values safely
    string toolTypeDisplay = toolTypes.Cast<object>().FirstOrDefault()?.ToString() ?? "";
    string awcDisplay = awcList.Cast<object>().FirstOrDefault()?.ToString() ?? "";
    string recipeDisplay = recipeList.Cast<object>().FirstOrDefault()?.ToString() ?? "";
}
@{   ViewData["Title"] = "RecipeParameter";}
<div class="BatchContainer p-3">
    <div class="w-100 BatchHeader">
        <div class="d-flex flex-wrap batchPageTabHeader gap-4">
            <nav class="flex-grow-1">
                <div class="nav nav-tabs" id="nav-tab" role="tablist">
                    <button class="nav-link font-size-16px clr-242424 fw-semibold active" id="nav-home-tab" data-bs-toggle="tab" data-bs-target="#nav-home" type="button" role="tab" aria-controls="nav-home" aria-selected="true">Parameter</button>
                    <button class="nav-link font-size-16px clr-242424 fw-semibold" id="nav-profile-tab" data-bs-toggle="tab" data-bs-target="#nav-profile" type="button" role="tab" aria-controls="nav-profile" aria-selected="false">Records</button>
                </div>
            </nav>
            <div class="d-flex gap-3 align-items-center">
                <label class="font-size-16px fw-semibold clr-242424">Recipe Code</label>
                <div class="d-flex RecipeCodeDropdown batchDropdown position-relative dropdown">
                    <input type="text" class="form-control dropdownInput bord-D2D2D2" id="currentRecipeCode"
                           value="@(Model.SelectedRecipe?.RecipeCode ?? "Select Recipe")" readonly>
                    <button type="button" class="bgcol-215ED6 border-0 flex-shrink-0 text-white dropdown-toggle dropdown-toggle-split dropdown-btn" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="visually-hidden">Toggle Dropdown</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        @if (Model.AllRecipeCodes != null && Model.AllRecipeCodes.Any())
                        {
                            foreach (var code in Model.AllRecipeCodes)
                            {
                                <li>
                                    <a class="dropdown-item" href="javascript:void(0)"
                                       onclick="updateRecipeSelection('@code')">@code</a>
                                </li>
                            }
                        }
                        else
                        {
                            <li><a class="dropdown-item disabled" href="#">No Recipes Found</a></li>
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="tab-content" id="nav-tabContent">
            <div class="tab-pane fade show active" id="nav-home" role="tabpanel" aria-labelledby="nav-home-tab">
                <div class="d-flex flex-wrap gap-3 py-4">
                    <button type="button" class="bord-D2D2D2 clr-242424 boxshadow font-size-14px fw-semibold rounded-2 py-2 px-3 bg-white"
                            data-bs-toggle="modal"
                            data-bs-target="#addRecipeModal">
                        Add Recipe
                    </button>
                    <button type="button" class="bord-D2D2D2 clr-242424 boxshadow font-size-14px fw-semibold rounded-2 py-2 px-3 bg-white">Edit Recipe</button>
                    <button type="button" class="bord-D2D2D2 clr-242424 boxshadow font-size-14px fw-semibold rounded-2 py-2 px-3 bg-white">Remove Recipe</button>
                    <button type="button" class="bord-D2D2D2 clr-242424 boxshadow font-size-14px fw-semibold rounded-2 py-2 px-3 bg-white">Print Recipe</button>
                </div>
                <!--Common Product Parameter-->
                <div class="commonProductParameter boxshadow bord-rad-4px mt-0">
                    <div class="commonProductHeader fw-semibold bgcol-215ED6 text-white text-center font-size-18px p-10px">
                        Common Product Parameter
                    </div>
                    <div class="py-4">
                        <div class="px-lg-4 px-md-4 px-sm-3 px-3">
                            <div class="commonProductHeaderSelectors d-flex flex-wrap gap-3 justify-content-between pb-4">

                                <div class="d-flex gap-3 align-items-center">
                                    <label class="font-size-16px fw-semibold clr-242424">Tool Type</label>
                                    <div class="d-flex toolTypeDropdown batchDropdown position-relative">
                                        <input type="text" class="form-control flex-grow-1 dropdownInput bord-D2D2D2"

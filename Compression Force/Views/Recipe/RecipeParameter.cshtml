                                    <div class="d-flex align-items-center gap-10px max-width-115px">
                                        <select id="forceFeederRatioS1" class="form-select bord-D2D2D2 px-12-py-6px w-70px bord-rad-4px font-size-12px col-242424 fw-semibold text-center">

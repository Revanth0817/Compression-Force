                                        <div class="d-flex align-items-center gap-10px max-width-115px">
                                            <input type="text" id="tabletWeight"
                                                   class="bord-D2D2D2 px-12-py-6px w-70px bord-rad-4px font-size-12px col-242424 fw-semibold text-center"
                                                   value="@Model.SelectedRecipe?.Weight" placeholder="0.00" readonly />
                                            <span class="font-size-16px fw-semibold clr-242424">mg</span>
                                        </div>
                                    </div>
                                    <div class="d-flex gap-3 align-items-center justify-content-between pb-2">
                                        <label class="font-size-16px min-width-30 fw-semibold clr-242424">Max Turret RPM</label>

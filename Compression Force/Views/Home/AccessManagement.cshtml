<!--User create Popup-->
<div class="modal fade" id="exampleModalToggle" aria-hidden="true" aria-labelledby="exampleModalToggleLabel" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bgcol-215ED6 text-white justify-content-between  font-size-18px">
                <h5 class="fw-semibold modal-title" id="exampleModalToggleLabel">
                    User Creaion
                </h5>
                <button type="button" class="bg-transparent border-0" data-bs-dismiss="modal" aria-label="Close"><img src="~/icons/closeicon.svg" /></button>
            </div>
            <div class="modal-body p-lg-4 p-md-4 p-sm-3 p-3 userCreationScroll">
                 <div class="d-flex gap-4 flex-lg-row flex-md-column flex-sm-column flex-column">
                        <div class="userCreationlefContainer">
                            <div class="position-relative w-60">
                                <div class="camera-preview d-flex align-items-center justify-content-center mb-3 rounded">
                                    Preview
                                </div>
                                <label class="btn btn-take-picture bord-D2D2D2 font-size-14 fw-semibold mb-3 boxshadow w-100">
                                    Take Picture
                                    <input type="file" accept="image/*" capture="user" hidden>
                                </label>
                            </div>
                            <p class="font-size-14 fw-semibold">Note: Make sure your password follows these rules to keep your account safe.</p>
                            <ul>
                                <li class="font-size-14 mb-3 clr-242424">At least 8-15 characters</li>
                                <li class="font-size-14 mb-3 clr-242424">Mix of upper and lower case letters</li>
                                <li class="font-size-14 mb-0 clr-242424">At least 1 number and 1 special Character</li>
                            </ul>
                            <p class="font-size-14"><span class="fw-semibold">Example:</span> Admin@1234</p>
                        </div>
                        <div class="flex-grow-1">
                            <form>
                                <div class="mb-2">
                                    <label for="userName" class="form-label font-size-14 fw-semibold">User Name</label>
                                    <input type="email" class="form-control" id="userName" aria-describedby="userName">
                                </div>
                                <div class="mb-2">
                                    <label for="password" class="form-label font-size-14 fw-semibold">Password</label>
                                    <input type="password" class="form-control" id="password">
                                </div>

                                <div class="mb-2">
                                    <label for="confirmPassword" class="form-label font-size-14 fw-semibold">Confirm Password</label>
                                    <input type="password" class="form-control" id="confirmPassword">
                                </div>

                                <div class="mb-2">
                                    <label for="exampleInputPassword1" class="form-label font-size-14 fw-semibold">Choose from Dropdown</label>
                                    <div class="d-flex RecipeCodeDropdown flex-grow-1 batchDropdown position-relative">
                                        <input type="text" class="form-control dropdownInput bord-D2D2D2" id="selectedItem" value="4321" readonly>
                                        <button type="button" class="bgcol-215ED6 border-0 flex-shrink-0 text-white dropdown-toggle dropdown-toggle-split dropdown-btn" data-bs-toggle="dropdown" aria-expanded="false">
                                            <span class="visually-hidden">Toggle Dropdown</span>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            <li><a class="dropdown-item" href="#">Maintenance</a></li>
                                            <li><a class="dropdown-item" href="#">2432</a></li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-end border-top-0 mt-4 pt-0 gap-3">
                                    <button type="button" class="btn col-215ED6 bord-215ED6 fw-semibold font-size-16px px-4 clr-215ED6" data-bs-dismiss="modal">Cancel</button>
                                    <button type="submit" class="btn bgcol-215ED6 text-white fw-semibold font-size-16px px-4">Create User</button>
                                </div>
                            </form>
                        </div>
                    </div>
            </div>
        </div>
    </div>
</div>

